<resources>
    <style name="Theme.PersonalHealthBuddy" parent="Theme.Material3.Light.NoActionBar">
        <!--
        Setting all system bar colors and the window background to holo_blue_bright
        ensures a consistent blue background during app initialization, preventing
        the white flash or lag.
        -->
        <item name="android:statusBarColor">@android:color/holo_blue_bright</item>
        <item name="android:navigationBarColor">@android:color/holo_blue_bright</item>

        <!-- The window background is the first color shown by the OS. -->
        <item name="android:windowBackground">@android:color/holo_blue_bright</item>

        <!-- Since holo_blue_bright is a light color, we use dark status bar icons (true). -->
        <item name="android:windowLightStatusBar">true</item>
    </style>
</resources>